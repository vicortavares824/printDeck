# PrintDeck Dashboard — variáveis de ambiente (Req 8.2, 8.4, 8.7, 8.8)
#
# Copie este arquivo para `.env` (ou `.env.local`) e preencha os valores.
# ATENÇÃO: NÃO existe variável para a `x-api-key` da Cloud_API. O frontend
# autoriza-se exclusivamente pelo Firebase_ID_Token (Authorization: Bearer).
# Nunca adicione a x-api-key aqui, em código do frontend ou em storage local.

# URL base da Cloud_API (obrigatória). Produção: https://printdeck-cloud.onrender.com
VITE_CLOUD_API_URL=https://printdeck-cloud.onrender.com

# Credenciais de configuração do Firebase_Auth (todas obrigatórias)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcionais do Firebase (recomendadas conforme o projeto; preencha quando aplicável)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
