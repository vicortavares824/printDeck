# ============================================================
# PrintDeck Cloud API - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório!
# ============================================================

# URL do banco de dados
# Desenvolvimento local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./printdeck.db

# Produção (Render PostgreSQL - o Render injeta automaticamente):
# DATABASE_URL=postgresql://usuario:senha@host:5432/printdeck_db

# Chave secreta para JWT (gere com: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=480

# Chave legada para rotas de telemetria
API_SECRET_KEY=printdeck-secret-token

# Origins permitidos (separados por vírgula)
ALLOWED_ORIGINS=["*"]

# Modo debug (false em produção)
DEBUG=false
